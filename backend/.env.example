# Copy to backend/.env, which Git ignores. Never commit the populated file.
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres
DB_USERNAME=postgres.YOUR_PROJECT_REFERENCE
DB_PASSWORD=
# Absolute path to the CA certificate downloaded from your Supabase dashboard.
DB_SSL_ROOT_CERT=C:/path/to/supabase-ca.crt
# Supply a private random value of at least 32 bytes.
JWT_SECRET=
DB_MIGRATIONS_ENABLED=false
CORS_ALLOWED_ORIGINS=https://lanka-ease.netlify.app,http://localhost:5173
# Password reset email (backend only). Use a verified Resend sender domain.
PASSWORD_RESET_RESEND_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_FRONTEND_URL=https://lanka-ease.netlify.app
